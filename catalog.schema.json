{
  "$defs": {
    "PolicyCommand": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "timeout": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "backends": {
          "items": {
            "enum": [
              "pyfly",
              "larafly",
              "java",
              "rust",
              "dotnet"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Backends",
          "type": "array"
        }
      },
      "required": [
        "argv",
        "backends"
      ],
      "title": "PolicyCommand",
      "type": "object"
    },
    "SkillPolicy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "category": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "kind": {
          "default": "recommendation",
          "enum": [
            "recommendation",
            "quality_gate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "title": "Default"
        },
        "instructions": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/PolicyCommand"
          },
          "maxItems": 10,
          "title": "Commands",
          "type": "array"
        },
        "adaptation": {
          "anyOf": [
            {
              "const": "instruction-only",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptation"
        },
        "adaptation_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptation Sha256"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "category",
        "instructions"
      ],
      "title": "SkillPolicy",
      "type": "object"
    },
    "SkillProvenance": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "source_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "license": {
          "enum": [
            "MIT",
            "Apache-2.0"
          ],
          "title": "License",
          "type": "string"
        },
        "license_path": {
          "maxLength": 300,
          "minLength": 1,
          "title": "License Path",
          "type": "string"
        },
        "license_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "License Sha256",
          "type": "string"
        },
        "license_text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "License Text",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "path",
        "source_url",
        "source_sha256",
        "license",
        "license_path",
        "license_sha256",
        "license_text"
      ],
      "title": "SkillProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillPolicy"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Skills",
      "type": "array"
    }
  },
  "required": [
    "version",
    "skills"
  ],
  "title": "CatalogDocument",
  "type": "object"
}
